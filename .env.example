# =============================================================================
# reporting_system_node — example of .env
# Every key the service reads, with the current non-secret values so they can be
# remembered. Secrets are placeholders: the real ones live only on the server.
# On start the service encrypts the real file to <name>.enc and deletes it
# (passcode typed at the prompt, or ENV_PASSCODE).
# =============================================================================

DB_AUTH_TYPE=sql
DB_HOST=206.189.57.0
DB_PORT=1433
DB_USERNAME=SA
DB_PASSWORD=<set-on-server>
DB_NAME=NEWDCC-V2-UAT
DASHBOARD_DEFAULT_LIMIT=10
REPORTS_EMPTY_FUNCTIONS_SEE_ALL=true
DB_REQUEST_TIMEOUT=60000
DB_CONNECT_TIMEOUT=60000
DB_POOL_MAX=200
DB_POOL_MIN=20
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000
DB_POOL_EVICT=1000
NODE_ENV=development
PORT=3002
JWT_SECRET=<set-on-server>
COOKIE_DOMAIN=.theubeg.ub.dom
SUPER_ADMIN_USERNAME=grcsvc
LDAP_ID_SMTP=10.240.5.217
LDAP_ID_PORT=25
LDAP_PASS=<set-on-server>
LDAP_IP=10.240.5.204
LDAP_URL=ldaps://dc01.adib.co.eg
LDAP_BIND_DN_DOMAIN=@adib.co.eg
LDAP_BIND_DN_USERNAME=GRCSVC@adib.co.eg
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_SEARCH_FILTER=sAMAccountName
LDAP_SEARCH_BASE=OU=GRC,DC=adib,DC=co,DC=eg
LDAP_SEARCH_BASE_DC=adib
LDAP_SEARCH_BASE_CO=co
LDAP_SEARCH_BASE_EG=eg
LDAP_PASSWORD=<set-on-server>
LDAP_SEARCH_OU=OU=GRC,DC=adib,DC=co,DC=eg
LDAP_ATTRIBUTES=cn,mail,sAMAccountName,title,memberOf,userPrincipalName
LDAP_OPERATION_TIMEOUT=30000
LDAP_TIMEOUT=10000
LDAP_CONNECT_TIMEOUT=5000
LDAP_IDLE_TIMEOUT=30000
LDAP_RECONNECT=true
LDAP_MAX_RETRIES=1
LDAP_RETRY_DELAY=2000
FROM_EMAIL=GRCSVC@adib.co.eg
FRONTEND_URL=https://dcc-grc.theubeg.ub.dom
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=https://dcc-reporting.theubeg.ub.dom,https://dcc-grc.theubeg.ub.dom,https://dcc-reporting-api-node.theubeg.ub.dom
ALLOWED_ORIGINS=https://dcc-reporting.theubeg.ub.dom,https://dcc-grc.theubeg.ub.dom,https://dcc-reporting-api-node.theubeg.ub.dom
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range
CORS_CREDENTIALS=true
IFRAME_MAIN_ORIGIN=https://dcc-grc.theubeg.ub.dom
MAIN_APP_ORIGIN=https://dcc-grc.theubeg.ub.dom
MAIN_BACKEND_URL=https://dcc-grc-api.theubeg.ub.dom
NEXT_PUBLIC_REPORTING_FRONTEND_URL=https://dcc-reporting.theubeg.ub.dom
REPORTING_FRONTEND_URL=https://dcc-reporting.theubeg.ub.dom
NODE_PUBLIC_URL=https://dcc-reporting-api-node.theubeg.ub.dom
ENTRY_TOKEN_ALLOWED_ORIGINS=https://dcc-grc.theubeg.ub.dom
LOGOUT_ALLOWED_ORIGINS=https://dcc-reporting.theubeg.ub.dom,https://dcc-grc.theubeg.ub.dom,https://dcc-reporting-api-node.theubeg.ub.dom
CERT_PATH=./certs.pem
VERIFY_SSL=true
MAIN_BACKEND_ENTRY_VALIDATE_PATH=/entry/validate
# AUTH_API_KEY — removed: it pointed the malware loader at its payload; nothing reads it now
COOKIE_SAMESITE=none
COOKIE_SECURE=true
